# Copy to .env and fill in real values. Variables and their meaning are
# documented in the frontend repo's docs/AGENTS.md under "Environment
# Variables" (this repo has no AGENTS.md of its own) -- keep the two in
# sync if a var is added or renamed here.

SUPABASE_URL=
SUPABASE_KEY=          # service role key, not anon -- bypasses RLS, see AGENTS.md's Security Notes
TMDB_ACCESS_TOKEN=
ADMIN_EMAIL=            # email compared against the signed-in user to gate /admin/* routes
